# ==============================================================================
# OT Güvenliği Rehberi - Suricata ICS/SCADA Tespit Kuralları Kütüphanesi
# Dosya: research/suricata-ics-rules.rules
# Sürüm: 1.0 (18.09.2026)
# Lisans: CC BY 4.0 / MIT
# Açıklama: Modbus, S7comm, DNP3, IEC 60870-5-104 ve CIP/EtherNet/IP protokolleri
# için hazırlanmış endüstriyel saldırı ve anomali tespit imzaları.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MODBUS TCP TESPİT KURALLARI (TCP Port 502)
# ------------------------------------------------------------------------------

# Kural 1: Modbus Tekil Bobin (Coil) Zorlama/Yazma Komutu (FC 05)
alert modbus $EXTERNAL_NET any -> $HOME_NET 502 (msg:"OT-IDS: Modbus FC05 Write Single Coil Request"; flow:established,to_server; modbus.function:5; modbus.access:write; classtype:protocol-command-decode; sid:1000001; rev:1;)

# Kural 2: Modbus Çoklu Holding Register Yazma İsteği (FC 16 / 0x10)
alert modbus $EXTERNAL_NET any -> $HOME_NET 502 (msg:"OT-IDS: Modbus FC16 Write Multiple Registers Detected"; flow:established,to_server; modbus.function:16; modbus.access:write; classtype:protocol-command-decode; sid:1000002; rev:1;)

# Kural 3: Modbus Tanılama / Loopback Test Taraması (FC 08 Diagnostics)
alert modbus $EXTERNAL_NET any -> $HOME_NET 502 (msg:"OT-IDS: Modbus FC08 Diagnostic Loopback Reconnaissance"; flow:established,to_server; modbus.function:8; classtype:attempted-recon; sid:1000003; rev:1;)

# Kural 4: Modbus Geçersiz/Tanımsız Fonksiyon Kodu (Fuzzing veya Exploit Girişimi)
alert tcp $EXTERNAL_NET any -> $HOME_NET 502 (msg:"OT-IDS: Modbus Invalid/Undefined Function Code (Anomaly)"; flow:established,to_server; content:"|00 00|"; depth:2; offset:2; byte_test:1,>,127,7; classtype:bad-unknown; sid:1000004; rev:1;)


# ------------------------------------------------------------------------------
# 2. SIEMENS S7COMM TESPİT KURALLARI (TCP Port 102 - ISO-on-TCP / COTP)
# ------------------------------------------------------------------------------

# Kural 5: S7comm PLC CPU STOP Komutu Enjeksiyonu
alert tcp $EXTERNAL_NET any -> $HOME_NET 102 (msg:"OT-IDS: Siemens S7comm CPU Stop Command Sent to PLC"; flow:established,to_server; content:"|32 01|"; depth:2; offset:7; content:"|29 00 00 00 00 00 09 50 5f 50 52 4f 47 52 41 4d|"; distance:0; classtype:policy-violation; sid:1000005; rev:1;)

# Kural 6: S7comm PLC Program Bloğu Yükleme (Block Download / Logic Modification)
alert tcp $EXTERNAL_NET any -> $HOME_NET 102 (msg:"OT-IDS: Siemens S7comm Program Block Download Initiation"; flow:established,to_server; content:"|32 01|"; depth:2; offset:7; content:"|1a 00|"; distance:0; classtype:attempted-admin; sid:1000006; rev:1;)

# Kural 7: S7comm SZL (System Status List) Donanım/Yazılım Keşif Okuması
alert tcp $EXTERNAL_NET any -> $HOME_NET 102 (msg:"OT-IDS: Siemens S7comm SZL Read Hardware/Firmware Discovery"; flow:established,to_server; content:"|32 01|"; depth:2; offset:7; content:"|04 01 12 04 11 44 01 00|"; distance:0; classtype:attempted-recon; sid:1000007; rev:1;)

# Kural 8: S7comm Değişken Zorlama (Force Request) Tespiti
alert tcp $EXTERNAL_NET any -> $HOME_NET 102 (msg:"OT-IDS: Siemens S7comm Variable Force Request Detected"; flow:established,to_server; content:"|32 01|"; depth:2; offset:7; content:"|05 01 12 08 12|"; distance:0; classtype:policy-violation; sid:1000008; rev:1;)


# ------------------------------------------------------------------------------
# 3. DNP3 SCADA TESPİT KURALLARI (TCP/UDP Port 20000)
# ------------------------------------------------------------------------------

# Kural 9: DNP3 Soğuk Yeniden Başlatma Komutu (Cold Restart - FC 0x0D)
alert tcp $EXTERNAL_NET any -> $HOME_NET 20000 (msg:"OT-IDS: DNP3 Outstation Cold Restart Command"; flow:established,to_server; content:"|05 64|"; depth:2; content:"|0d|"; offset:12; depth:1; classtype:policy-violation; sid:1000009; rev:1;)

# Kural 10: DNP3 Doğrudan Kumanda / Kesici Aç-Kapa (Direct Operate - FC 0x05)
alert tcp $EXTERNAL_NET any -> $HOME_NET 20000 (msg:"OT-IDS: DNP3 Direct Operate Control Command"; flow:established,to_server; content:"|05 64|"; depth:2; content:"|05|"; offset:12; depth:1; classtype:protocol-command-decode; sid:1000010; rev:1;)

# Kural 11: DNP3 Güvenlik Kimlik Doğrulama Hatası (SAv5 Auth Failure Indication)
alert tcp $HOME_NET 20000 -> $EXTERNAL_NET any (msg:"OT-IDS: DNP3 SAv5 Security Authentication Failure Response"; flow:established,to_client; content:"|05 64|"; depth:2; content:"|83|"; offset:12; depth:1; classtype:bad-unknown; sid:1000011; rev:1;)


# ------------------------------------------------------------------------------
# 4. IEC 60870-5-104 TELEKONTROL TESPİT KURALLARI (TCP Port 2404)
# ------------------------------------------------------------------------------

# Kural 12: IEC 104 Tek Komut (C_SC_NA_1 - TypeID 45) Kumanda Enjeksiyonu
alert tcp $EXTERNAL_NET any -> $HOME_NET 2404 (msg:"OT-IDS: IEC 104 C_SC_NA_1 Single Command Sent to RTU"; flow:established,to_server; content:"|68|"; depth:1; content:"|2d|"; offset:6; depth:1; classtype:protocol-command-decode; sid:1000012; rev:1;)

# Kural 13: IEC 104 Genel İstasyon Sorgusu (C_IC_NA_1 - TypeID 100 Interrogation)
alert tcp $EXTERNAL_NET any -> $HOME_NET 2404 (msg:"OT-IDS: IEC 104 General Interrogation Command"; flow:established,to_server; content:"|68|"; depth:1; content:"|64|"; offset:6; depth:1; classtype:attempted-recon; sid:1000013; rev:1;)

# Kural 14: IEC 104 İletişim Başlatma Testi (STARTDT ACT)
alert tcp $EXTERNAL_NET any -> $HOME_NET 2404 (msg:"OT-IDS: IEC 104 STARTDT ACT Data Transfer Activation"; flow:established,to_server; content:"|68 04 07 00 00 00|"; depth:6; classtype:protocol-command-decode; sid:1000014; rev:1;)


# ------------------------------------------------------------------------------
# 5. ETHERNET/IP & CIP TESPİT KURALLARI (TCP/UDP Port 44818)
# ------------------------------------------------------------------------------

# Kural 15: EtherNet/IP CIP Generic Write (Değişken / Tag Üzerine Yazma)
alert tcp $EXTERNAL_NET any -> $HOME_NET 44818 (msg:"OT-IDS: EtherNet/IP CIP Write Tag Service (0x4D)"; flow:established,to_server; content:"|4d 00|"; distance:0; classtype:protocol-command-decode; sid:1000015; rev:1;)

# Kural 16: EtherNet/IP Forward Open Bağlantı İsteği (Yeni PLC Oturumu)
alert tcp $EXTERNAL_NET any -> $HOME_NET 44818 (msg:"OT-IDS: EtherNet/IP CIP Forward Open Connection Request"; flow:established,to_server; content:"|6f 00|"; depth:2; offset:0; classtype:protocol-command-decode; sid:1000016; rev:1;)
